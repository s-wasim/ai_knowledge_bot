# Required. Claude handles query rewriting, relevance selection, and answering.
ANTHROPIC_API_KEY=

# Postgres with the pgvector and pg_trgm extensions.
DATABASE_URL=postgresql://postgres:postgres@db:5432/knowledgebot

# Optional. Caps chunks stored per repo (default 20000). Truncation is reported,
# never silent.
# KB_MAX_CHUNKS=20000
